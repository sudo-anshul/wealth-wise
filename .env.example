# Copy this file to apps/web/.env.local for local Next.js development.
# Public Supabase project configuration. The publishable/anon key is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The legacy anon key is accepted when a publishable key is not provided.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical origin for email verification and password recovery redirects.
# Use an environment-specific origin and add its auth callback paths in Supabase.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# No service-role key or financial/AI provider credential is needed for this release.
