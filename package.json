{
  "name": "wealthwise",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm --filter @wealthwise/web dev",
    "build": "pnpm --filter @wealthwise/web build",
    "start": "pnpm --filter @wealthwise/web start",
    "typecheck": "pnpm --filter @wealthwise/web typecheck",
