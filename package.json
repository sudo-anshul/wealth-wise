    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.19.11",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "type": "module"
}
